include AGENTS.md UPSTREAM.md COMPATIBILITY.md requirements.lock THIRD_PARTY_NOTICES.md
include config.example.toml pfor.ps1
recursive-include docs *.md *.json
recursive-include tools *.py
recursive-include tests *.py
recursive-include web_dashboard *.html *.css *.js *.txt
recursive-include pfor_qmt/migrations *.sql
recursive-include qmt_scripts *.py
prune runtime
prune log
prune exports
prune output
prune .venv
global-exclude *.pyc *.local.json
global-exclude config.toml *.local.toml
